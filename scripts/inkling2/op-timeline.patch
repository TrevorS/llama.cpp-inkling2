+// XTMP bytes one op group reads and writes: inputs made outside the group plus the last output
+// MUL_MAT_ID reads only the used experts, GET_ROWS only the gathered rows (estimates)
+static double ggml_metal_op_x_bytes(ggml_metal_op_t ctx, int idx, int n) {
+    std::vector<const ggml_tensor *> group;
+    for (int i = 0; i < n; ++i) {
+        group.push_back(ctx->node(idx + i));
+    }
+    auto in_group = [&](const ggml_tensor * t) {
+        for (const ggml_tensor * g : group) {
+            if (t == g || t->view_src == g) {
+                return true;
+            }
+        }
+        return false;
+    };
+
+    double res = 0;
+    std::vector<const ggml_tensor *> seen;
+    for (const ggml_tensor * node : group) {
+        for (int j = 0; j < GGML_MAX_SRC; ++j) {
+            const ggml_tensor * s = node->src[j];
+            if (!s || in_group(s) || std::find(seen.begin(), seen.end(), s) != seen.end() || (node->op == GGML_OP_SET_ROWS && j == 2)) {
+                continue;
+            }
+            seen.push_back(s);
+            double b = ggml_nbytes(s);
+            if (node->op == GGML_OP_MUL_MAT_ID && j == 0 && node->src[2]) {
+                b *= std::min(1.0, (double) ggml_nelements(node->src[2]) / s->ne[2]);
+            } else if (node->op == GGML_OP_GET_ROWS && j == 0) {
+                b = (double) ggml_row_size(s->type, s->ne[0]) * ggml_nelements(node->src[1]);
+            }
+            res += b;
+        }
+    }
+    const ggml_tensor * last = group.back();
+    if (last->op == GGML_OP_SET_ROWS) {
+        res += (double) ggml_row_size(last->type, last->src[0]->ne[0]) * ggml_nrows(last->src[0]);
+    } else {
+        res += ggml_nbytes(last);
+    }
+
+    return res;
+}
+
+static bool ggml_metal_op_x_timed(const ggml_tensor * node) {
+    switch (node->op) {
+        case GGML_OP_NONE:
+        case GGML_OP_RESHAPE:
+        case GGML_OP_VIEW:
+        case GGML_OP_TRANSPOSE:
+        case GGML_OP_PERMUTE:
+            return false;
+        default:
+            return !ggml_is_empty(node) && (node->flags & GGML_TENSOR_FLAG_COMPUTE);
+    }
+}
+
+struct ggml_metal_op_timing {
+    std::vector<ggml_metal_sample_buf_t> sbufs;
+    std::vector<ggml_metal_op::rec> recs;
+};
+
+struct ggml_metal_op_timing * ggml_metal_op_take_timing(ggml_metal_op_t ctx) {
+    if (ctx->sbufs.empty()) {
+        return nullptr;
+    }
+    auto * t = new ggml_metal_op_timing { std::move(ctx->sbufs), std::move(ctx->recs) };
+    ctx->sbufs.clear();
+    return t;
+}
+
+void ggml_metal_op_timing_print(struct ggml_metal_op_timing * t, int graph, int cb) {
+    const int per = ggml_metal_op::x_ops_per_sbuf;
+    std::vector<uint64_t> ts(2*per*t->sbufs.size());
+    int m = 0;
+    for (size_t i = 0; i < t->sbufs.size(); ++i) {
+        const int n = 2*std::min(per, (int) t->recs.size() - (int) i*per);
+        const int got = ggml_metal_sample_buf_read(t->sbufs[i], n, ts.data() + 2*per*i);
+        m = got == n ? 2*per*(int) i + n : m;
+        if (got != n) {
+            break;
+        }
+    }
+    std::string out;
+    char line[256];
+    for (size_t k = 0; k < t->recs.size() && (int) (2*k + 1) < m; ++k) {
+        const auto & r = t->recs[k];
+        snprintf(line, sizeof(line), "XOP\t%d\t%d\t%d\t%d\t%s\t%s\t%d\t%d\t%.0f\t%llu\t%llu\n", graph, cb, r.idx, r.n_fuse, r.op, r.name, r.ne0, r.ne1, r.bytes,
+                (unsigned long long) ts[2*k], (unsigned long long) ts[2*k + 1]);
+        out += line;
+    }
+    fputs(out.c_str(), stderr);
+    for (auto * sb : t->sbufs) {
+        ggml_metal_sample_buf_free(sb);
+    }
+    delete t;
+}
