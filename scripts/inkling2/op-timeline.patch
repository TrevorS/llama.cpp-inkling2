+void ggml_metal_sample_buf_free(ggml_metal_sample_buf_t sbuf) {
+    [(id<MTLCounterSampleBuffer>) sbuf release];
+}
+
+int ggml_metal_sample_buf_read(ggml_metal_sample_buf_t sbuf, int n, uint64_t * out) {
+    int m = 0;
+    @autoreleasepool {
+        NSData * data = [(id<MTLCounterSampleBuffer>) sbuf resolveCounterRange:NSMakeRange(0, n)];
+        if (data) {
+            const MTLCounterResultTimestamp * ts = (const MTLCounterResultTimestamp *) data.bytes;
+            m = (int) (data.length / sizeof(MTLCounterResultTimestamp));
+            for (int i = 0; i < m; ++i) {
+                out[i] = ts[i].timestamp;
+            }
+        }
+    }
+    return m;
+}
+
+ggml_metal_encoder_t ggml_metal_encoder_init_sampled(ggml_metal_cmd_buf_t cmd_buf_raw, bool concurrent, ggml_metal_sample_buf_t sbuf, int i0, int i1) {
+    ggml_metal_encoder_t res = calloc(1, sizeof(struct ggml_metal_encoder));
+
+    id<MTLCommandBuffer> cmd_buf = (id<MTLCommandBuffer>) cmd_buf_raw;
+
+    MTLComputePassDescriptor * desc = [MTLComputePassDescriptor computePassDescriptor];
+    desc.dispatchType = concurrent ? MTLDispatchTypeConcurrent : MTLDispatchTypeSerial;
+    desc.sampleBufferAttachments[0].sampleBuffer              = (id<MTLCounterSampleBuffer>) sbuf;
+    desc.sampleBufferAttachments[0].startOfEncoderSampleIndex = i0;
+    desc.sampleBufferAttachments[0].endOfEncoderSampleIndex   = i1;
+
+    res->obj = [cmd_buf computeCommandEncoderWithDescriptor:desc];
+    [res->obj retain];
+
+    return res;
+}
